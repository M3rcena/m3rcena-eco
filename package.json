{
  "name": "@m3rcena/eco",
  "version": "14.28.1-1",
  "description": "The ultimate Discord.js v14 economy engine. Dual wallet/bank, career jobs, items & inventory, businesses, interactive casino gambling, robbery, market trading, and web dashboard bridge.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./resolver": {
      "types": "./dist/resolver.d.mts",
      "import": "./dist/resolver.mjs",
      "require": "./dist/resolver.cjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.cjs"
    },
    "./host": {
      "types": "./dist/host.d.mts",
      "import": "./dist/host.mjs",
      "require": "./dist/host.cjs"
    },
    "./source": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "DOCUMENTATION.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "dev": "tsdown --watch",
    "host": "tsx src/host.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/index.test.ts && tsx test/database.test.ts && tsx test/connector.test.ts && tsx test/submodule.test.ts"
  },
  "keywords": [
    "m3rcena",
    "eco",
    "economy",
    "discord-economy",
    "discord.js",
    "discord.js-v14",
    "components-v2",
    "casino",
    "blackjack",
    "inventory",
    "banking",
    "businesses",
    "jobs"
  ],
  "author": "M3rcena <https://github.com/M3rcena>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/M3rcena/m3rcena-eco.git"
  },
  "bugs": {
    "url": "https://github.com/M3rcena/m3rcena-eco/issues"
  },
  "homepage": "https://github.com/M3rcena/m3rcena-eco#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@m3rcena/bridge": "^14.28.1-1",
    "@napi-rs/canvas": "^0.1.68",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
